# کپی کن به .env و مقادیر واقعی رو بذار

DATABASE_URL="postgresql://user:password@localhost:5432/sabzchat"
JWT_SECRET="a-very-long-random-secret-change-this"
JWT_EXPIRES_IN="30d"
PORT=4000

# آدرس‌هایی که اجازه دارن به سرور وصل بشن (فرانت وب/موبایل)
CORS_ORIGIN="http://localhost:5173"

# آپلود فایل/مدیا — می‌تونی بعداً به S3 یا هر object storage دیگه وصلش کنی
UPLOAD_DIR="./uploads"

# سرور TURN برای برقراری تماس صوتی/تصویری پشت NAT (مثلاً coturn خودت یا Twilio)
TURN_URL="turn:your-turn-server:3478"
TURN_USERNAME=""
TURN_CREDENTIAL=""
